<Window x:Class="PointerBridge_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointerBridge_Server"
        mc:Ignorable="d"
        Title="PointerBridge-Server" Height="450" Width="800"
        MinHeight="260" MinWidth="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="关于" Click="About_Click"/>
            <MenuItem Header="调试" Click="Debug_Click"/>
        </Menu>

        <WrapPanel Grid.Row="2" Margin="10,10,10,0">
            <Label Content="监听端口：" FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="ListenPortTextBox" Text="38899" Width="90"
                     FontSize="15" VerticalAlignment="Center" Margin="0,5,10,5"/>
            <Button x:Name="ListenButton" Content="开始监听" FontSize="15"
                    Padding="10,3" VerticalAlignment="Center" Margin="0,5,0,5"
                    Click="Listen_Click"/>
        </WrapPanel>

        <TextBlock x:Name="ListenStatusTextBlock" Grid.Row="3" Text="未监听"
                   Margin="15,8,15,0" TextWrapping="Wrap"/>

        <Button Grid.Row="4" Content="退出" HorizontalAlignment="Center"
                Margin="0,15,0,15" FontSize="15" Width="60" Click="Exit_Click"/>
    </Grid>
</Window>
