<Window x:Class="PointerBridge_Client.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PointerBridge 调试信息"
        Width="800" Height="450"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="清空" Padding="12,4" Click="Clear_Click"/>
            <TextBlock Text="调试日志（最近 1000 条，可选择并复制）" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBox x:Name="LogTextBox" Grid.Row="1"
                 IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas, Microsoft YaHei" FontSize="13"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
